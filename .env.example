# Copy to .env at the repository root. Replace secrets before starting Compose.
# The Ollama stack is the current production configuration.
SURREAL_USER=root
SURREAL_PASS=replace-with-a-strong-secret
LLM_PROVIDER=ollama
OLLAMA_MODEL=replace-with-installed-model
CORTEX_MODEL_WARMUP=true
CORTEX_API_KEY=
CORTEX_IDENTITY_MAP={}

# Optional hosted model settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=home-cortex

# Optional read-only calendar integration.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
CALENDAR_TIMEZONE=America/Los_Angeles
CALENDAR_BINDINGS=[]

# Media service defaults.
HOME_MEDIA_THUMBNAIL_SIZE=500
HOME_MEDIA_PAGE_SIZE=100

# Candidate llama.cpp stack only; see artifacts/llamacpp-migration/CONTINUATION.md.
LLAMA_SERVER_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:014f721265464f38ccb247c1338d07d852c4bae7509a4b4734d07a2bbadc765c
LLAMA_MODEL_FILE=model.gguf
LOCAL_LLM_MODEL=local-model
LLAMA_CTX_SIZE=16384
LLAMA_GPU_LAYERS=99
LLAMA_PARALLEL=1
LLAMA_CHAT_TEMPLATE=chatml
