data/nodes/*
data/edges/*
.env
*.secret
.venv/
__pycache__/
.pytest_cache/
# Experiment snapshots used only on the production GPU host; reproduce from the
# JSON reports in artifacts/qwen35-semantic-contract instead of committing blobs.
artifacts/qwen35-semantic-contract/*.tar

# Generated benchmark results: keep only the readable *-summary.json files and
# prose reports. The large per-case JSONs are derived output, not source, and are
# preserved on disk (and in git history) but not tracked going forward.
artifacts/**/probe-*.json
artifacts/**/suite-*.json
artifacts/tier1-baseline/probe.json
artifacts/tier1-baseline/suite.json
artifacts/qwen35-semantic-contract/baseline-relevant-rows.json
!artifacts/**/*-summary.json
