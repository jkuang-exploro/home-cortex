SURREAL_USER=root
SURREAL_PASS=replace-with-a-strong-password
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
# To use OpenRouter instead of local Ollama:
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-replace-with-your-key
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
CORTEX_API_KEY=replace-with-a-long-random-secret
# Map an Open WebUI user ID or email to a stable home-graph person ID.
CORTEX_IDENTITY_MAP={"email:you@example.com":"person:john_smith"}
