@@ -0,0 +1,84 @@
+import asyncio
+import logging
+import os
+
+import aiohttp
+from fastapi import APIRouter, Depends, HTTPException, status
+from pydantic import BaseModel, Field
+
+from open_webui.utils.auth import get_verified_user
+
+log = logging.getLogger(__name__)
+router = APIRouter()
+
+CORTEX_INTERNAL_URL = os.environ.get(
+    'CORTEX_INTERNAL_URL',
+    'http://cortex-api:8000',
+).rstrip('/')
+CORTEX_API_KEY = os.environ.get('CORTEX_API_KEY', '')
+CORTEX_GREETING_AGENT = os.environ.get('CORTEX_GREETING_AGENT', 'steward')
+CORTEX_GREETING_LANGUAGE = os.environ.get('CORTEX_GREETING_LANGUAGE', '').strip()
+
+
+class ConversationForm(BaseModel):
+    language: str = Field(
+        default='en',
+        min_length=2,
+        max_length=35,
+        pattern=r'^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$',
+    )
+
+
+@router.post('/conversations/{agent_id}')
+async def create_cortex_conversation(
+    agent_id: str,
+    form_data: ConversationForm,
+    user=Depends(get_verified_user),
+):
+    if agent_id != CORTEX_GREETING_AGENT:
+        raise HTTPException(
+            status_code=status.HTTP_404_NOT_FOUND,
+            detail='Cortex greeting agent was not found',
+        )
+    if not CORTEX_API_KEY:
+        raise HTTPException(
+            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
+            detail='Cortex greeting bridge is not configured',
+        )
+
+    headers = {
+        'Authorization': f'Bearer {CORTEX_API_KEY}',
+        'Content-Type': 'application/json',
+        'X-OpenWebUI-User-Id': str(user.id),
+    }
+    if user.email:
+        headers['X-OpenWebUI-User-Email'] = user.email
+
+    try:
+        timeout = aiohttp.ClientTimeout(total=10)
+        async with aiohttp.ClientSession(timeout=timeout) as session:
+            async with session.post(
+                f'{CORTEX_INTERNAL_URL}/agent/{agent_id}/conversations',
+                headers=headers,
+                json={
+                    'language': CORTEX_GREETING_LANGUAGE or form_data.language,
+                },
+            ) as response:
+                payload = await response.json(content_type=None)
+                if response.status >= 400:
+                    error = payload.get('error', {}) if isinstance(payload, dict) else {}
+                    message = error.get('message', 'Cortex greeting request failed')
+                    log.warning(
+                        'Cortex greeting request failed with status %s',
+                        response.status,
+                    )
+                    raise HTTPException(status_code=response.status, detail=message)
+                return payload
+    except HTTPException:
+        raise
+    except (asyncio.TimeoutError, aiohttp.ClientError):
+        log.warning('Cortex greeting service is unavailable', exc_info=True)
+        raise HTTPException(
+            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
+            detail='Cortex greeting service is unavailable',
+        )
diff --git a/src/lib/apis/cortex/index.ts b/src/lib/apis/cortex/index.ts
new file mode 100644
index 0000000..59cbf8c
--- /dev/null
+++ b/src/lib/apis/cortex/index.ts
@@ -0,0 +1,33 @@
+import { WEBUI_API_BASE_URL } from '$lib/constants';
+
+export const createCortexConversation = async (
+	token: string,
+	agentId: string,
+	language: string
+) => {
+	let error = null;
+
+	const response = await fetch(
+		`${WEBUI_API_BASE_URL}/cortex/conversations/${encodeURIComponent(agentId)}`,
+		{
+			method: 'POST',
+			headers: {
+				Accept: 'application/json',
+				'Content-Type': 'application/json',
+				authorization: `Bearer ${token}`
+			},
+			body: JSON.stringify({ language })
+		}
+	)
+		.then(async (res) => {
+			if (!res.ok) throw await res.json();
+			return res.json();
+		})
+		.catch((err) => {
+			error = err?.detail ?? 'Unable to initialize the Cortex greeting';
+			return null;
+		});
+
+	if (error) throw new Error(error);
+	return response;
+};
